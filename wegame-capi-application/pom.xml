<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.wegame</groupId>
        <artifactId>wegame-capi</artifactId>
        <version>1.0.0</version>
    </parent>
    <groupId>com.wegame</groupId>
    <artifactId>wegame-capi-application</artifactId>
    <version>1.0.0</version>
    <name>wegame-capi-application</name>
    <packaging>jar</packaging>
    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.wegame</groupId>
            <artifactId>wegame-capi-api</artifactId>
        </dependency>

        <dependency>
            <groupId>com.wegame</groupId>
            <artifactId>wegame-capi-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wegame</groupId>
            <artifactId>wegame-capi-client</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wegame</groupId>
            <artifactId>wegame-capi-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wegame</groupId>
            <artifactId>wegame-capi-dao</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wegame</groupId>
            <artifactId>wegame-capi-scheduler</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wegame</groupId>
            <artifactId>wegame-capi-scheduler</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources/config/${config-dir}</directory>
            </resource>
            <resource>
                <directory>src/main/resources/json</directory>
            </resource>
        </resources>
        <directory>../target</directory>
        <finalName>${parent.artifactId}-${parent.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-archetype-plugin</artifactId>
                <version>3.0.0</version>
            </plugin>
            <plugin>
                <groupId>org.codec</groupId>
                <artifactId>skeleton-maven-plugin</artifactId>
                <version>1.0.0.20241111</version>
                <!-- <systemPath>${basedir}srclibldapjdk.jar</systemPath>-->
                <configuration>
                    <!--项目目录-->
                    <projectPathDir>/Users/apple/Documents/project/wegame/wegame-capi</projectPathDir>
                    <!--项目名-->
                    <projectName>wegame-capi</projectName>
                    <!--基础包名-->
                    <basePackageName>com.wegame.base</basePackageName>
                    <!--业务包名-->
                    <businessPackageName>com.wegame.capi</businessPackageName>
                    <!--业务包名 backend/business/*-->
                    <subBusinessPackageName>user</subBusinessPackageName>
                    <!--是否覆盖已有文件-->
                    <fileOverWrite>true</fileOverWrite>
                    <!--db jdbc url-->
                    <jdbcUrl>jdbc:mysql://localhost:3306/wegame_business_db</jdbcUrl>
                    <!--db name-->
                    <dbName>wegame_business_db</dbName>
                    <!--db username-->
                    <username>root</username>
                    <!--db password-->
                    <password>rootroot</password>
                    <multiDataSource>true</multiDataSource>
                    <generateDelete>true</generateDelete>
                    <!--指定表-->
<!--                    <indexTableNameList>boxing_match</indexTableNameList>-->
<!--                    <indexModuleList>po,poQuery,mapper,domain,converter,pageQueryRequest,vo</indexModuleList>-->
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>